{{ file_managed_by_ansible }}

# This template will set all of the auditd configurations via a handler in the role in one task instead of individually

{% set audit_present_dirs = discovered_audit_optional_dirs.results | default([]) | selectattr('stat.exists') | map(attribute='item') | list %}

{% if ubtu26cis_rule_6_2_3_1 %}
-a always,exit -F arch=b64 -F path=/etc/sudoers -F perm=wa -k scope
-a always,exit -F arch=b64 -F dir=/etc/sudoers.d -F perm=wa -k scope
{% endif %}
{% if ubtu26cis_rule_6_2_3_2 %}
{% set syscalls = ["execve"] %}
{% set arch_syscalls = syscalls | select("in", supported_syscalls) | list %}
-a always,exit -F arch=b64 -C euid!=uid -F auid!=unset -S {{ arch_syscalls|join(',') }} -k user_emulation
-a always,exit -F arch=b32 -C euid!=uid -F auid!=unset -S {{ arch_syscalls|join(',') }} -k user_emulation
{% endif %}
{% if ubtu26cis_rule_6_2_3_3 %}
-a always,exit -F arch=b64 -F path={{ ubtu26cis_sudo_logfile }} -F perm=wa -k sudo_log_file
{% endif %}
{% if ubtu26cis_rule_6_2_3_4 %}
{% set syscalls = ["adjtimex","settimeofday"] %}
{% set arch_syscalls = syscalls | select("in", supported_syscalls) | list %}
-a always,exit -F arch=b64 -S {{ arch_syscalls|join(',') }} -k time-change
-a always,exit -F arch=b32 -S {{ arch_syscalls|join(',') }} -k time-change
-a always,exit -F arch=b64 -S clock_settime -F a0=0x0 -k time-change
-a always,exit -F arch=b32 -S clock_settime -F a0=0x0 -k time-change
-a always,exit -F arch=b64 -F path=/etc/localtime -F perm=wa -k localtime-change
{% endif %}
{% if ubtu26cis_rule_6_2_3_5 %}
{% set syscalls = ["sethostname","setdomainname"] %}
{% set arch_syscalls = syscalls | select("in", supported_syscalls) | list %}
-a always,exit -F arch=b64 -S {{ arch_syscalls|join(',') }} -k system-locale
-a always,exit -F arch=b32 -S {{ arch_syscalls|join(',') }} -k system-locale
{% endif %}
{% if ubtu26cis_rule_6_2_3_6 %}
-a always,exit -F arch=b64 -F path=/etc/issue -F perm=wa -k system-locale
-a always,exit -F arch=b64 -F path=/etc/issue.net -F perm=wa -k system-locale
{% endif %}
{% if ubtu26cis_rule_6_2_3_7 %}
-a always,exit -F arch=b64 -F path=/etc/hosts -F perm=wa -k system-locale
-a always,exit -F arch=b64 -F path=/etc/hostname -F perm=wa -k system-locale
{% endif %}
{% if ubtu26cis_rule_6_2_3_8 %}
-a always,exit -F arch=b64 -F path=/etc/network/interfaces -F perm=wa -k system-locale
{% if '/etc/network/interfaces.d' in audit_present_dirs %}
-a always,exit -F arch=b64 -F dir=/etc/network/interfaces.d -F perm=wa -k system-locale
{% endif %}
-a always,exit -F arch=b64 -F dir=/etc/netplan/ -F perm=wa -k system-locale
{% endif %}
{% if ubtu26cis_rule_6_2_3_9 %}
{% if '/etc/NetworkManager' in audit_present_dirs %}
-a always,exit -F arch=b64 -F dir=/etc/NetworkManager/ -F perm=wa -k system-locale
{% endif %}
{% endif %}
{% if ubtu26cis_rule_6_2_3_10 %}
{% if discovered_privilege_processes is defined %}
{% for proc in discovered_privilege_processes.stdout_lines -%}
-a always,exit -F path={{ proc }} -F perm=x -F auid>=1000 -F auid!=unset -k privileged
{% endfor %}
{% endif %}
{% endif %}
